@keyframes biliplayer-num
  0%
    transform scale(1.6)
    opacity 0
  100%
    transform scale(1)
    opacity 1

.p-biliplayer
  user-select none
  width $aside_width - $gap * 8
  margin $gap * 4
  border-radius $gap * 0.5
  border 1px solid var(--color-clear)
  background var(--color-background)
  animation panels-appear 0.6s ease

.p-biliplayer-caption
  display flex
  align-items center
  justify-content space-between
  padding 0 $gap
  font-size 0.8em
  line-height 2.5
  background var(--color-clear)
  > .p-biliplayer-caption-text
    overflow hidden
    white-space nowrap
    text-overflow ellipsis
  > .p-biliplayer-ops
    flex none

.p-biliplayer button
  cursor pointer
  padding 0 $gap * 0.5
  border none
  background none
  color inherit
  font-size inherit
  line-height inherit
  min-width 3.5em
  min-height 1.9em
  text-align center
  &:hover
    color var(--color-primary)

.p-biliplayer-start, .p-biliplayer-cancel
  border 1px solid var(--color-primary) !important
  border-radius $gap * 0.5

.p-biliplayer-stage
  position relative
  width 100%
  padding-bottom 56.25%
  background #000
  > iframe
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    border 0

.p-biliplayer-mask
  position absolute
  top 0
  left 0
  right 0
  bottom 0
  display flex
  flex-direction column
  align-items center
  justify-content center
  padding $gap
  background var(--color-background)
  text-align center
  font-size 0.85em
  > .p-biliplayer-start
    display none
  &.waiting .p-biliplayer-num
    display none
  &.manual .p-biliplayer-start
    display inline-block
  &.manual
    .p-biliplayer-tip, .p-biliplayer-num, .p-biliplayer-cancel
      display none
  > .p-biliplayer-num
    display block
    font-size 2.2em
    line-height 1.4
    animation biliplayer-num 0.9s ease

.p-biliplayer-nav
  display flex
  align-items center
  padding $gap * 0.5 $gap
  font-size 0.75em
  background var(--color-clear)
  > .p-biliplayer-now
    flex 1 1 auto
    min-width 0
    padding 0 $gap * 0.5
    overflow hidden
    white-space nowrap
    text-overflow ellipsis
    text-align center
  > .p-biliplayer-prev, > .p-biliplayer-next
    flex none
