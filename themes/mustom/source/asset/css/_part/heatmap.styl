.p-heatmap
  user-select none
  width $aside_width - $gap * 8
  margin $gap * 4
  border-radius $gap * 0.5
  border 1px solid var(--color-clear)
  background var(--color-background)
  animation panels-appear 0.6s ease

.p-heatmap-caption
  display flex
  align-items center
  justify-content space-between
  position relative
  padding 0 $gap
  font-size 0.8em
  line-height 2.5
  background var(--color-clear)
  cursor help

.p-heatmap-caption:hover .p-heatmap-tip, .p-heatmap-caption:focus .p-heatmap-tip, .p-heatmap-caption.on .p-heatmap-tip
  opacity 1
  visibility visible

// 和页脚那三个气泡同一套做法，但朝下开：面板贴在侧栏最底部，
// 往上开会顶出侧栏可视区，触屏那一下点开的气泡就看不见了
.p-heatmap-tip
  position absolute
  left $gap
  right $gap
  top s('calc(100% + %s)', $gap * 0.5)
  // 页脚那条气泡是 min(90vw, 22em)，那是贴着视口底边、左右都有余量的写法；
  // 这条在侧栏里，面板只有 254px，按视口算宽会溢出侧栏压到正文上，
  // 所以左右都钉在标题栏内边距上、让文本自己折行
  padding $gap * 0.5 $gap
  font-size $font_size * 0.75
  line-height 1.5
  font-style normal
  text-align left
  color var(--color-header-text)
  background var(--color-clear)
  border 1px solid var(--color-post-ending)
  border-radius $gap * 0.5
  opacity 0
  visibility hidden
  transition opacity 0.2s
  z-index zIndex(1)

.p-heatmap-chart
  width 100%
  height 196px

.p-heatmap-unit
  display none

.m-aside .p-heatmap
  display none
  @media (min-width $app_mobile_width_min)
    display block

.m-drawer .p-heatmap
  @media (min-width $app_mobile_width_min)
    display none
