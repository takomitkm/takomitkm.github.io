.p-heatmap
  user-select none
  width $aside_width - $gap * 8
  margin $gap * 4
  border-radius $gap * 0.5
  border 1px solid var(--color-clear)
  background var(--color-background)
  animation panels-appear 0.6s ease

.p-heatmap-caption
  display flex
  align-items center
  justify-content space-between
  padding 0 $gap
  font-size 0.8em
  line-height 2.5
  background var(--color-clear)

.p-heatmap-chart
  width 100%
  height 196px

.p-heatmap-unit
  display none

.m-aside .p-heatmap
  display none
  @media (min-width $app_mobile_width_min)
    display block

.m-drawer .p-heatmap
  @media (min-width $app_mobile_width_min)
    display none
