<div class="p-biliplayer HIDE"
  data-playlist="<%- theme.biliplayer.playlist %>"
  data-countdown="<%- theme.biliplayer.countdown %>">
  <div class="p-biliplayer-caption">
    <span class="p-biliplayer-caption-text" data-lang="biliplayer.caption"></span>
    <span class="p-biliplayer-ops">
      <button type="button" class="p-biliplayer-off">×</button>
    </span>
  </div>
  <div class="p-biliplayer-stage">
    <div class="p-biliplayer-mask HIDE">
      <span class="p-biliplayer-tip" data-lang="biliplayer.willplay"></span>
      <b class="p-biliplayer-num"></b>
      <button type="button" class="p-biliplayer-cancel" data-lang="biliplayer.cancel"></button>
      <button type="button" class="p-biliplayer-start" data-lang="biliplayer.play"></button>
    </div>
  </div>
  <div class="p-biliplayer-nav">
    <button type="button" class="p-biliplayer-prev" data-lang="biliplayer.prev"></button>
    <span class="p-biliplayer-now"></span>
    <button type="button" class="p-biliplayer-next" data-lang="biliplayer.next"></button>
  </div>
</div>
